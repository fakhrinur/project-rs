# ============================================
# Salin file ini menjadi `.env` lalu isi nilainya.
# File `.env` TIDAK akan ikut ter-commit ke Git.
# ============================================

# Connection string PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/nama_database?schema=public"

# Port server API
PORT=4000

# Kunci rahasia JWT - ganti dengan string acak yang panjang
JWT_SECRET="ganti-dengan-string-acak-yang-panjang-dan-susah-ditebak"

# Origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"
